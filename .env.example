# HELIX AI environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real keys.
# Next.js will not load these until you restart `pnpm run dev`.

# Supabase project (the only backend). Found in Project Settings > API.
# NEXT_PUBLIC_ aliases are also accepted.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Public origin baked into confirmation and password-reset links.
# Production must be the real site, for example https://helix-ai-two.vercel.app
# If this is left as localhost while VERCEL_ENV=production, the app ignores it
# and uses VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra comma-separated emails provisioned as agency admins on signup.
# cultleaderzoz.dev@gmail.com is always included in code.
AGENCY_ADMIN_EMAILS=

# Shared secret for inbound /api/webhooks/n8n/* requests. Required.
# There is no built-in default.
HELIX_WEBHOOK_SECRET=
# Server-side only. Bypasses RLS; never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding /api/cron/process-agent-tasks. Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>` when configured.
CRON_SECRET=

# Optional isolated addresses used only by scripts/verify-*.mjs seed runs.
# Never real inboxes; the scripts create and delete these Auth users themselves.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_EMAIL_ADMIN=

# Workspace uuid used only by scripts/verify-crm-contact-roundtrip.mjs
CRM_TEST_CLIENT_ID=

PORT=3000

# Built-in Lead Generation Engine (Cloudflare Browser Run + Bright Data Web Unlocker)
# Server-side only — NEVER prefix with NEXT_PUBLIC_
LEADGEN_BUILTIN_ENGINE=true
LEADGEN_PREFER_EXTERNAL_WORKER=false

# Cloudflare Browser Run Quick Action (/content endpoint)
CF_ACCOUNT_ID=
CF_BROWSER_TOKEN=
LEADGEN_BROWSER_DAILY_SECONDS_CAP=540

# Bright Data Web Unlocker Direct API (/request endpoint)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=helix_unlocker
LEADGEN_STEALTH_MONTHLY_CAP=4500

# Optional Scrapling Docker Worker (Kept for optional self-hosted container path)
SCRAPLING_WORKER_ENABLED=false
SCRAPLING_WORKER_URL=http://localhost:8080
SCRAPLING_DEFAULT_ENGINE=auto
SCRAPLING_ROBOTS_OBEY=true
SCRAPLING_MAX_CONCURRENCY=4
SCRAPLING_PROXY_LIST=
SCRAPLING_CHECKPOINT_DIR=/tmp/helix-leadgen-checkpoints
SCRAPLING_CREDIT_PER_PAGE=0.15
SCRAPLING_CREDIT_BASE=1.0
SCRAPLING_DOCKER_IMAGE=ghcr.io/d4vinci/scrapling:latest
LEADGEN_INTELLIGENCE_PROXY_ENABLED=false
LEADGEN_INTELLIGENCE_PROXY_URL=
HUNTER_API_KEY=
HUNTER_MONTHLY_CAP=45

# TinyFish Search / Fetch / Agent APIs (server-side only)
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai/v1
TINYFISH_AGENT_ENABLED=false
TINYFISH_AGENT_MAX_SECONDS=90
TINYFISH_FETCH_URLS_PER_DAY=900

# Google Places API (New) & Geocoding (server-side only)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_FIELD_TIER=enterprise
GOOGLE_PLACES_MONTHLY_CAP=900
GOOGLE_GEOCODE_MONTHLY_CAP=9000
GOOGLE_BILLING_MODE=trial
GOOGLE_TRIAL_ENDS=

# Foursquare Places API
FOURSQUARE_API_KEY=
FOURSQUARE_MONTHLY_CAP=450

# OpenStreetMap
OSM_ENABLED=true
OSM_OVERPASS_DAILY_CAP=500
OSM_CONTACT_EMAIL=

# Bright Data SERP Maps
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_SERP_MONTHLY_CAP=1000

# Places Fallback Order
PLACES_PROVIDER_ORDER=google_places,foursquare,osm_overpass,brightdata_serp

# Helix MCP & API Key Pepper
HELIX_API_KEY_PEPPER=

